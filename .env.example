# ========================
# WhatsApp AI Chatbot - Environment Variables
# ========================

# --- Server ---
PORT=9999
NODE_ENV=development

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/whatsapp-ai-chatbot

# --- Security (REQUIRED — server will NOT start without this) ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_your_64_char_random_secret_here

# --- CORS (comma-separated list of allowed frontend origins) ---
# Development:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Production example:
# ALLOWED_ORIGINS=https://yourdashboard.com,https://yourdomain.com

# --- WhatsApp Meta Cloud API ---
WHATSAPP_VERIFY_TOKEN=my_secret_verify_token_123

# --- Lead Alert Email (global fallback — each client sets their own SMTP in Settings) ---
LEAD_NOTIFICATION_EMAIL=sales@yourcompany.com

# --- Groq API (FREE Whisper Audio-to-Text) ---
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- OpenAI (Wabex AI Managed Brain Default Key) ---
OPENAI_API_KEY=your_openai_api_key_here
