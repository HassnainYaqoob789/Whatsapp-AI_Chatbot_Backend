# ========================
# WhatsApp AI Chatbot - Environment Variables
# ========================

# --- Server ---
PORT=8888
NODE_ENV=development

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/whatsapp-ai-chatbot

# --- WhatsApp Meta Cloud API ---
WHATSAPP_TOKEN=YOUR_META_PERMANENT_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=YOUR_WABA_ID
WHATSAPP_VERIFY_TOKEN=my_secret_verify_token_123

# --- SMTP (Email Notifications for Leads) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=your-email@example.com

# --- Lead Alert Email ---
LEAD_NOTIFICATION_EMAIL=sales@yourcompany.com
